    <div class="stg-row"><div class="stg-info"><h4>JSON Import</h4><p>Backup einspielen</p></div><div><input type="file" id="imp" accept=".json" style="display:none" onchange="importJSON(event)"><button class="btn bg_ bsm" onclick="document.getElementById('imp').click()">⬆ Import</button></div></div>
