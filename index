function renderMeterCards(){
  const month=document.getElementById('r-month').value;
  const el=document.getElementById('r-meters');
  if(!D.tenants.length){el.innerHTML='<div style="text-align:center;color:var(--tx3);padding:30px">Erst Mieter anlegen!</div>';return;}
  el.innerHTML=D.tenants.filter(t=>t.status==='active').map(t=>{
    const existing=D.readings.find(r=>r.tenantId===t.id&&r.month===month);
    const prev=getPrevReading(t.id,month);
    const curVal=existing?existing.reading:'';
    const consumption=(existing&&prev!==null)?Math.max(0,existing.reading-prev):null;
    return`<div class="mr-card">
      <div class="mr-info"><div class="mr-name"><span class="td" style="background:${tc(t.id)}"></span>${t.name}</div><div class="mr-detail">${t.unit} · Zähler: ${t.meter}</div></div>
      <div class="mr-prev"><div class="lbl">Vorheriger Stand</div><div class="val">${prev!==null?fn(prev,1):'-'}</div></div>
      <div class="mr-input"><input type="number" data-tid="${t.id}" class="reading-input" value="${curVal}" placeholder="Aktueller Stand" step="0.01" oninput="calcReadingDiff(this,'${t.id}')"></div>
      <div class="mr-result"><div class="lbl">Verbrauch</div><div class="val" id="rdiff-${t.id}">${consumption!==null?fn(consumption,1)+' kWh':'-'}</div></div>
    </div>`;
  }).join('');
}

function calcReadingDiff(input,tid){
  const month=document.getElementById('r-month').value;
  const prev=getPrevReading(tid,month);
  const val=parseFloat(input.value);
  const el=document.getElementById('rdiff-'+tid);
  if(!isNaN(val)&&prev!==null){
    const diff=Math.max(0,val-prev);
    el.textContent=fn(diff,1)+' kWh';
    el.style.color=diff>0?'var(--ac)':'var(--tx3)';
  } else {
    el.textContent='-';el.style.color='var(--ac)';
  }
}

document.addEventListener('change',e=>{if(e.target.id==='r-month')renderMeterCards();});

function saveReadings(){
  const month=document.getElementById('r-month').value;
  if(!month)return alert('Monat wählen!');
  const inputs=document.querySelectorAll('.reading-input');
  let saved=0;
  inputs.forEach(inp=>{
    const tid=inp.dataset.tid,val=parseFloat(inp.value);
    if(isNaN(val))return;
    const ex=D.readings.find(r=>r.tenantId===tid&&r.month===month);
    if(ex){ex.reading=val;ex.updatedAt=Date.now();}
    else D.readings.push({id:id(),tenantId:tid,month,reading:val,createdAt:Date.now()});
    saved++;
  });
  if(!saved)return alert('Keine Stände eingegeben!');
  sv();
  alert(saved+' Zählerstand/stände gespeichert!');
  renderMeterCards();
}

function renderMainMeter(){
  const month=document.getElementById('r-month').value;
  const ex=D.mainReadings.find(r=>r.month===month);
  document.getElementById('r-main').value=ex?ex.reading:'';
  // Find prev
  const all=D.mainReadings.sort((a,b)=>a.month.localeCompare(b.month));
  const idx=all.findIndex(r=>r.month===month);
  const prev=idx>0?all[idx-1].reading:null;
  document.getElementById('r-main-prev').value=prev!==null?fn(prev,1):'-';
  // Calc common electricity
  if(ex&&prev!==null){
    const mainC=ex.reading-prev;
    let tenantC=0;
    D.tenants.forEach(t=>{const c=getConsumption(t.id,month);if(c)tenantC+=c;});
    document.getElementById('r-common').value=fn(Math.max(0,mainC-tenantC),1)+' kWh (Allgemeinstrom)';
  } else {
    document.getElementById('r-common').value='-';
  }
}

function saveMainReading(){
  const month=document.getElementById('r-month').value;
  const val=parseFloat(document.getElementById('r-main').value);
  if(!month||isNaN(val))return alert('Monat und Stand eingeben!');
  const ex=D.mainReadings.find(r=>r.month===month);
  if(ex)ex.reading=val;
  else D.mainReadings.push({id:id(),month,reading:val,createdAt:Date.now()});
  sv();renderMainMeter();
}

