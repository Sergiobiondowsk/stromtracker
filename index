  let csv='Mieter;Büro;Zähler;Monat;Zählerstand;Verbrauch kWh;Kosten €\n';
  rs.forEach(r=>{const t=D.tenants.find(t=>t.id===r.tenantId);const c=getConsumption(r.tenantId,r.month);csv+=`${t?t.name:'?'};${t?t.unit:'-'};${t?t.meter:'-'};${r.month};${r.reading};${c||0};${c?calcCost(c).toFixed(2):0}\n`;});
  dl(csv,'zaehlerstaende.csv','text/csv');
}

