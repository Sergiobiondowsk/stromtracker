<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>StromTracker Pro – Gebäudeverwaltung</title>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<style>
:root{--bg0:#06070a;--bg:#0b0d12;--s1:#11141b;--s2:#181c26;--s3:#1f2430;--bd:#262c3a;--bd2:#323a4d;--tx:#e2e5ed;--tx2:#8a90a4;--tx3:#525870;--ac:#e8b931;--ac2:#f5cc4d;--acd:rgba(232,185,49,.12);--gn:#2dd4a0;--gnd:rgba(45,212,160,.12);--rd:#ef6060;--rdd:rgba(239,96,96,.12);--bl:#5b9ef0;--bld:rgba(91,158,240,.12);--pu:#9b7ef0;--pud:rgba(155,126,240,.12);--or:#f0923c;--cy:#22d3ee;--side:260px;--head:58px;--r:12px;--rs:8px}
*{margin:0;padding:0;box-sizing:border-box}
html{font-size:14px}
body{font-family:'Instrument Sans',-apple-system,sans-serif;background:var(--bg0);color:var(--tx);min-height:100vh;overflow-x:hidden}

.sidebar{position:fixed;left:0;top:0;bottom:0;width:var(--side);background:var(--bg);border-right:1px solid var(--bd);display:flex;flex-direction:column;z-index:200;transition:transform .3s}
.sb-brand{padding:18px 20px;border-bottom:1px solid var(--bd);display:flex;align-items:center;gap:12px}
.sb-logo{width:36px;height:36px;background:var(--ac);border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:17px;font-weight:800;color:var(--bg0);flex-shrink:0}
.sb-title{font-size:15px;font-weight:700;letter-spacing:-.3px;line-height:1.2}
.sb-sub{font-size:10px;color:var(--tx3);font-weight:500}
.sb-nav{flex:1;padding:10px;overflow-y:auto}
.sb-sec{font-size:9px;text-transform:uppercase;letter-spacing:1.5px;color:var(--tx3);padding:14px 12px 6px;font-weight:700}
.sb-item{display:flex;align-items:center;gap:11px;padding:9px 13px;border-radius:var(--rs);cursor:pointer;font-size:13px;font-weight:500;color:var(--tx2);transition:all .15s;border:1px solid transparent;margin-bottom:1px}
.sb-item:hover{background:var(--s1);color:var(--tx)}
.sb-item.on{background:var(--acd);color:var(--ac);border-color:rgba(232,185,49,.15)}
.sb-item .ic{font-size:15px;width:20px;text-align:center;flex-shrink:0}
.sb-item .bg{margin-left:auto;font-size:9px;background:var(--s3);color:var(--tx3);padding:2px 7px;border-radius:10px;font-family:'JetBrains Mono',monospace;font-weight:600}
.sb-foot{padding:14px;border-top:1px solid var(--bd);font-size:10px;color:var(--tx3);display:flex;align-items:center;gap:7px}
.sd{width:6px;height:6px;background:var(--gn);border-radius:50%;box-shadow:0 0 6px var(--gn)}

.top{position:fixed;top:0;left:var(--side);right:0;height:var(--head);background:rgba(11,13,18,.85);backdrop-filter:blur(20px);border-bottom:1px solid var(--bd);display:flex;align-items:center;justify-content:space-between;padding:0 24px;z-index:150}
.top-t{font-size:15px;font-weight:600}
.top-r{display:flex;align-items:center;gap:14px}
.clk{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--tx3);background:var(--s1);padding:5px 11px;border-radius:6px;border:1px solid var(--bd)}
.mob-tog{display:none;background:var(--s1);border:1px solid var(--bd);color:var(--tx);padding:7px 11px;border-radius:var(--rs);cursor:pointer;font-size:16px}

.main{margin-left:var(--side);padding-top:var(--head);min-height:100vh}
.mc{padding:24px;max-width:1340px}
.ph{margin-bottom:24px}
.ph h2{font-size:21px;font-weight:700;letter-spacing:-.4px;margin-bottom:3px}
.ph p{color:var(--tx3);font-size:13px}

.card{background:var(--s1);border:1px solid var(--bd);border-radius:var(--r);margin-bottom:18px;overflow:hidden}
.ch{padding:16px 20px;border-bottom:1px solid var(--bd);display:flex;justify-content:space-between;align-items:center}
.ch h3{font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.8px;color:var(--tx2)}
.cb{padding:20px}
.cb.np{padding:0}

.sr{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px;margin-bottom:22px}
.sc{background:var(--s1);border:1px solid var(--bd);border-radius:var(--r);padding:18px 20px;position:relative;overflow:hidden;transition:border-color .2s}
.sc:hover{border-color:var(--bd2)}
.sc::before{content:'';position:absolute;top:0;left:0;right:0;height:2px}
.sc.cy::before{background:linear-gradient(90deg,var(--ac),transparent)}
.sc.cg::before{background:linear-gradient(90deg,var(--gn),transparent)}
.sc.cb_::before{background:linear-gradient(90deg,var(--bl),transparent)}
.sc.cr::before{background:linear-gradient(90deg,var(--rd),transparent)}
.sc.cp::before{background:linear-gradient(90deg,var(--pu),transparent)}
.si{width:34px;height:34px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:15px;margin-bottom:12px}
.sc.cy .si{background:var(--acd)}.sc.cg .si{background:var(--gnd)}.sc.cb_ .si{background:var(--bld)}.sc.cr .si{background:var(--rdd)}.sc.cp .si{background:var(--pud)}
.sl{font-size:10px;color:var(--tx3);text-transform:uppercase;letter-spacing:.8px;font-weight:600;margin-bottom:5px}
.sv{font-size:24px;font-weight:700;letter-spacing:-.8px;font-family:'JetBrains Mono',monospace;line-height:1.1}
.su{font-size:12px;color:var(--tx3);font-weight:400}
.sf{margin-top:8px;display:flex;align-items:center;gap:6px;font-size:11px}
.bu{background:var(--rdd);color:var(--rd);padding:2px 7px;border-radius:5px;font-weight:600;font-size:10px}
.bd_{background:var(--gnd);color:var(--gn);padding:2px 7px;border-radius:5px;font-weight:600;font-size:10px}
.bn{background:var(--s3);color:var(--tx3);padding:2px 7px;border-radius:5px;font-weight:600;font-size:10px}

.g2{display:grid;grid-template-columns:1fr 1fr;gap:18px}
.g3{display:grid;grid-template-columns:2fr 1fr;gap:18px}
.cw{position:relative;height:260px}
.cws{position:relative;height:200px}

table{width:100%;border-collapse:collapse}
th{text-align:left;padding:10px 16px;font-size:10px;text-transform:uppercase;letter-spacing:1px;color:var(--tx3);font-weight:600;background:var(--s2);border-bottom:1px solid var(--bd);white-space:nowrap}
td{padding:11px 16px;border-bottom:1px solid var(--bd);font-size:13px;white-space:nowrap}
tr:last-child td{border-bottom:none}
tr:hover td{background:rgba(255,255,255,.015)}
.mn{font-family:'JetBrains Mono',monospace;font-weight:500}

.tb{display:inline-flex;align-items:center;gap:6px;font-weight:600;font-size:13px}
.td{width:8px;height:8px;border-radius:50%;flex-shrink:0}

.fr{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px;margin-bottom:16px}
.fg{display:flex;flex-direction:column;gap:4px}
.fg label{font-size:10px;text-transform:uppercase;letter-spacing:.5px;color:var(--tx3);font-weight:600}
input,select,textarea{background:var(--bg);border:1px solid var(--bd);border-radius:var(--rs);padding:8px 12px;color:var(--tx);font-family:'JetBrains Mono',monospace;font-size:13px;outline:none;transition:border-color .2s,box-shadow .2s}
input:focus,select:focus,textarea:focus{border-color:var(--ac);box-shadow:0 0 0 3px var(--acd)}
select option{background:var(--s1)}
textarea{font-family:'Instrument Sans',sans-serif;resize:vertical;min-height:60px}

.btn{padding:8px 18px;border:none;border-radius:var(--rs);font-family:inherit;font-size:12px;font-weight:700;cursor:pointer;transition:all .15s;display:inline-flex;align-items:center;gap:6px;white-space:nowrap}
.ba{background:var(--ac);color:var(--bg0)}.ba:hover{background:var(--ac2);transform:translateY(-1px);box-shadow:0 4px 16px var(--acd)}
.bg_{background:var(--s2);color:var(--tx2);border:1px solid var(--bd)}.bg_:hover{border-color:var(--bd2);color:var(--tx)}
.br{background:var(--rdd);color:var(--rd)}.br:hover{background:var(--rd);color:#fff}
.bsm{padding:5px 12px;font-size:11px}
.bgrp{display:flex;gap:7px;flex-wrap:wrap}

.pr{margin-bottom:16px}.pr:last-child{margin-bottom:0}
.prh{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px}
.prl{display:flex;align-items:center;gap:7px;font-size:13px;font-weight:600}
.prs{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--tx3)}
.prt{height:7px;background:var(--s3);border-radius:4px;overflow:hidden}
.prf{height:100%;border-radius:4px;transition:width .6s ease}

.ri{display:flex;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid var(--bd)}
.ri:last-child{border-bottom:none}
.rn{font-family:'JetBrains Mono',monospace;font-size:17px;font-weight:700;color:var(--tx3);width:28px;text-align:center}
.rn.t1{color:var(--ac)}
.rinfo{flex:1}.rinfo .nm{font-weight:600;font-size:13px;margin-bottom:1px}.rinfo .dt{font-size:11px;color:var(--tx3)}
.rv{font-family:'JetBrains Mono',monospace;font-size:15px;font-weight:600;text-align:right}
.rv .ut{font-size:10px;color:var(--tx3);font-weight:400}

.kpi{display:flex;gap:22px;flex-wrap:wrap;padding:14px 20px;background:var(--s2)}
.ki{display:flex;flex-direction:column;gap:2px}
.ki .kl{font-size:9px;text-transform:uppercase;letter-spacing:.5px;color:var(--tx3);font-weight:600}
.ki .kv{font-family:'JetBrains Mono',monospace;font-size:14px;font-weight:600}

.stg-row{display:flex;justify-content:space-between;align-items:center;padding:14px 0;border-bottom:1px solid var(--bd)}
.stg-row:last-child{border-bottom:none}
.stg-info h4{font-size:13px;font-weight:600;margin-bottom:2px}
.stg-info p{font-size:11px;color:var(--tx3)}

.page{display:none}.page.on{display:block}
.so{display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:190}.so.open{display:block}

/* Alert badges */
.alert-badge{display:inline-flex;align-items:center;gap:4px;padding:3px 9px;border-radius:5px;font-size:11px;font-weight:600}
.alert-warn{background:rgba(240,146,60,.12);color:var(--or)}
.alert-ok{background:var(--gnd);color:var(--gn)}
.alert-miss{background:var(--rdd);color:var(--rd)}

/* Meter reading card */
.mr-card{background:var(--s2);border:1px solid var(--bd);border-radius:var(--rs);padding:16px;margin-bottom:10px;display:grid;grid-template-columns:1fr auto auto auto;gap:14px;align-items:center}
.mr-card .mr-info{display:flex;flex-direction:column;gap:2px}
.mr-card .mr-name{font-weight:600;font-size:13px;display:flex;align-items:center;gap:7px}
.mr-card .mr-detail{font-size:11px;color:var(--tx3)}
.mr-card .mr-prev{text-align:right}
.mr-card .mr-prev .lbl{font-size:10px;color:var(--tx3);text-transform:uppercase;letter-spacing:.5px}
.mr-card .mr-prev .val{font-family:'JetBrains Mono',monospace;font-size:15px;font-weight:600}
.mr-card .mr-input input{width:130px}
.mr-card .mr-result{text-align:right;min-width:80px}
.mr-card .mr-result .lbl{font-size:10px;color:var(--tx3);text-transform:uppercase;letter-spacing:.5px}
.mr-card .mr-result .val{font-family:'JetBrains Mono',monospace;font-size:15px;font-weight:700;color:var(--ac)}

/* Billing table */
.bill-summary{background:var(--s2);border:1px solid var(--bd);border-radius:var(--rs);padding:18px;margin-bottom:14px}
.bill-row{display:flex;justify-content:space-between;padding:6px 0;font-size:13px}
.bill-row.total{border-top:2px solid var(--bd);margin-top:8px;padding-top:10px;font-weight:700;font-size:15px}
.bill-row .bill-label{color:var(--tx2)}
.bill-row .bill-val{font-family:'JetBrains Mono',monospace;font-weight:600}
.bill-row.positive .bill-val{color:var(--gn)}
.bill-row.negative .bill-val{color:var(--rd)}

/* Tenant detail card */
.td-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:14px}
.td-card{background:var(--s2);border:1px solid var(--bd);border-radius:var(--rs);padding:16px}
.td-card h4{font-size:12px;color:var(--tx3);text-transform:uppercase;letter-spacing:.5px;margin-bottom:10px;font-weight:600}
.td-field{display:flex;justify-content:space-between;padding:5px 0;font-size:13px;border-bottom:1px solid var(--bd)}
.td-field:last-child{border-bottom:none}
.td-field .lbl{color:var(--tx3)}
.td-field .val{font-weight:600}

/* Wizard overlay */
.wiz-overlay{position:fixed;inset:0;background:var(--bg0);z-index:1000;display:flex;align-items:center;justify-content:center}
.wiz-box{background:var(--s1);border:1px solid var(--bd);border-radius:16px;padding:36px;width:92%;max-width:580px;max-height:90vh;overflow-y:auto}
.wiz-box h2{font-size:22px;font-weight:800;margin-bottom:6px;letter-spacing:-.3px}
.wiz-box .wiz-sub{color:var(--tx3);font-size:13px;margin-bottom:24px}
.wiz-steps{display:flex;gap:6px;margin-bottom:24px}
.wiz-step{flex:1;height:4px;border-radius:2px;background:var(--s3)}
.wiz-step.done{background:var(--ac)}
.wiz-step.cur{background:var(--ac);opacity:.5}
.wiz-actions{display:flex;gap:10px;justify-content:flex-end;margin-top:24px}

/* Heatmap */
.hm{display:grid;grid-template-columns:auto repeat(12,1fr);gap:3px;font-size:11px}
.hm-h{text-align:center;color:var(--tx3);font-family:'JetBrains Mono',monospace;font-size:9px;padding:3px 2px}
.hm-l{padding:5px 6px 5px 0;text-align:right;color:var(--tx2);font-size:10px;font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:90px}
.hm-c{border-radius:3px;display:flex;align-items:center;justify-content:center;font-family:'JetBrains Mono',monospace;font-size:8px;color:transparent;transition:all .15s;cursor:default;min-height:26px;aspect-ratio:1.5}
.hm-c:hover{color:var(--tx);transform:scale(1.08);z-index:2}

@media(max-width:1024px){.g2,.g3{grid-template-columns:1fr}}
@media(max-width:768px){.sidebar{transform:translateX(-100%)}.sidebar.open{transform:translateX(0)}.main{margin-left:0}.top{left:0}.mob-tog{display:block}.sr{grid-template-columns:1fr 1fr}.mc{padding:16px}.mr-card{grid-template-columns:1fr;gap:10px}}
@media(max-width:480px){.sr{grid-template-columns:1fr}}
::-webkit-scrollbar{width:5px;height:5px}::-webkit-scrollbar-track{background:transparent}::-webkit-scrollbar-thumb{background:var(--bd);border-radius:3px}
@keyframes fadeUp{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}.fu{animation:fadeUp .3s ease forwards}
</style>
</head>
<body>
<div class="so" id="sov" onclick="toggleSB()"></div>
<aside class="sidebar" id="sb">
  <div class="sb-brand"><div class="sb-logo">⚡</div><div><div class="sb-title">StromTracker</div><div class="sb-sub" id="sb-building">Gebäude</div></div></div>
  <nav class="sb-nav">
    <div class="sb-sec">Übersicht</div>
    <div class="sb-item on" data-p="dashboard" onclick="go('dashboard',this)"><span class="ic">📊</span>Dashboard</div>
    <div class="sb-item" data-p="readings" onclick="go('readings',this)"><span class="ic">📟</span>Zählerstände</div>
    <div class="sb-item" data-p="analytics" onclick="go('analytics',this)"><span class="ic">📈</span>Analyse</div>
    <div class="sb-sec">Verwaltung</div>
    <div class="sb-item" data-p="tenants" onclick="go('tenants',this)"><span class="ic">🏢</span>Mieter<span class="bg" id="b-tc">0</span></div>
    <div class="sb-item" data-p="billing" onclick="go('billing',this)"><span class="ic">📄</span>Abrechnung</div>
    <div class="sb-item" data-p="payments" onclick="go('payments',this)"><span class="ic">💶</span>Abschläge</div>
    <div class="sb-item" data-p="history" onclick="go('history',this)"><span class="ic">📋</span>Verlauf<span class="bg" id="b-ec">0</span></div>
    <div class="sb-sec">System</div>
    <div class="sb-item" data-p="settings" onclick="go('settings',this)"><span class="ic">⚙️</span>Einstellungen</div>
  </nav>
  <div class="sb-foot"><span class="sd"></span>Lokal gespeichert</div>
</aside>
<header class="top">
  <div style="display:flex;align-items:center;gap:12px"><button class="mob-tog" onclick="toggleSB()">☰</button><div class="top-t" id="topT">Dashboard</div></div>
  <div class="top-r"><div class="clk" id="clk"></div></div>
</header>
<div class="main"><div class="mc" id="mc">

<!-- SETUP WIZARD -->
<div class="wiz-overlay" id="wizard" style="display:none">
<div class="wiz-box">
  <div class="wiz-steps"><div class="wiz-step" id="ws1"></div><div class="wiz-step" id="ws2"></div><div class="wiz-step" id="ws3"></div></div>
  <div id="wiz-content"></div>
</div>
</div>

<!-- DASHBOARD -->
<div class="page on fu" id="p-dashboard">
  <div class="ph"><h2>Dashboard</h2><p id="d-sub"></p></div>
  <div class="sr" id="d-stats"></div>
  <div id="d-alerts" style="margin-bottom:18px"></div>
  <div class="g3">
    <div class="card"><div class="ch"><h3>Monatsverbrauch</h3><select id="d-yr" onchange="rDash()" style="padding:4px 9px;font-size:11px"></select></div><div class="cb"><div class="cw"><canvas id="cBar"></canvas></div></div></div>
    <div class="card"><div class="ch"><h3>Anteil Mieter</h3></div><div class="cb"><div class="cw"><canvas id="cDon"></canvas></div></div></div>
  </div>
  <div class="g2">
    <div class="card"><div class="ch"><h3>Ranking</h3></div><div class="cb" id="d-rank"></div></div>
    <div class="card"><div class="ch"><h3>Prognose</h3></div><div class="cb" id="d-prog"></div></div>
  </div>
</div>

<!-- READINGS -->
<div class="page" id="p-readings">
  <div class="ph"><h2>Zählerstände erfassen</h2><p>Monatliche Zählerablesung für alle Mieter</p></div>
  <div class="card">
    <div class="ch"><h3>Ablesung</h3></div>
    <div class="cb">
      <div class="fr">
        <div class="fg"><label>Monat</label><input type="month" id="r-month"></div>
      </div>
      <div id="r-meters"></div>
      <div class="bgrp" style="margin-top:14px">
        <button class="btn ba" onclick="saveReadings()">✓ Alle Stände speichern</button>
      </div>
    </div>
  </div>
  <div class="card" id="r-main-card">
    <div class="ch"><h3>Hauptzähler Gebäude</h3></div>
    <div class="cb">
      <div class="fr">
        <div class="fg"><label>Zählerstand Hauptzähler</label><input type="number" id="r-main" step="0.01" placeholder="Aktueller Stand"></div>
        <div class="fg"><label>Vorheriger Stand</label><input type="text" id="r-main-prev" disabled style="opacity:.6"></div>
        <div class="fg"><label>Allgemeinstrom (berechnet)</label><input type="text" id="r-common" disabled style="color:var(--or);opacity:1"></div>
      </div>
      <button class="btn ba bsm" onclick="saveMainReading()">Hauptzähler speichern</button>
    </div>
  </div>
</div>

<!-- ANALYTICS -->
<div class="page" id="p-analytics">
  <div class="ph"><h2>Analyse</h2><p>Verbrauch, Kosten, Trends</p></div>
  <div class="sr" id="a-stats"></div>
  <div class="card">
    <div class="ch"><h3>Kosten vs. Verbrauch</h3><select id="a-yr" onchange="rAnalytics()" style="padding:4px 9px;font-size:11px"></select></div>
    <div class="cb"><div class="cw"><canvas id="cCK"></canvas></div></div>
  </div>
  <div class="card"><div class="ch"><h3>Heatmap kWh</h3></div><div class="cb" id="a-hm"></div></div>
</div>

<!-- TENANTS -->
<div class="page" id="p-tenants">
  <div class="ph"><h2>Mieter verwalten</h2><p>Büros, Kontakte, Zähler, Flächen</p></div>
  <div class="card">
    <div class="ch"><h3>Neuen Mieter anlegen</h3><button class="btn bg_ bsm" onclick="toggleTForm()" id="tf-tog">+ Formular öffnen</button></div>
    <div class="cb" id="t-form" style="display:none">
      <div class="fr">
        <div class="fg"><label>Firma / Name *</label><input type="text" id="tf-name" placeholder="Müller GmbH"></div>
        <div class="fg"><label>Ansprechpartner</label><input type="text" id="tf-contact" placeholder="Max Müller"></div>
        <div class="fg"><label>E-Mail</label><input type="email" id="tf-email" placeholder="max@mueller.de"></div>
        <div class="fg"><label>Telefon</label><input type="text" id="tf-phone" placeholder="+49 ..."></div>
      </div>
      <div class="fr">
        <div class="fg"><label>Büro / Einheit *</label><input type="text" id="tf-unit" placeholder="2.OG links"></div>
        <div class="fg"><label>Fläche (m²)</label><input type="number" id="tf-area" placeholder="85" step="0.1" min="0"></div>
        <div class="fg"><label>Zählernummer *</label><input type="text" id="tf-meter" placeholder="Z-001234"></div>
