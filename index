function loadDemo(){
  if(D.tenants.length&&!confirm('Bestehende Daten werden ersetzt!'))return;
  const ts=[
    {id:'d1',name:'Müller GmbH',contact:'Hans Müller',email:'h.mueller@mueller.de',phone:'+49 211 12345',unit:'EG links',area:95,meter:'Z-1001',moveIn:'2022-01-15',monthlyAdvance:130,initReading:10000,notes:'',status:'active'},
