    <div class="stg-row"><div class="stg-info"><h4>Setup-Wizard</h4><p>Ersteinrichtung erneut starten</p></div><button class="btn bg_ bsm" onclick="startWizard()">🔄 Wizard starten</button></div>
    <div class="stg-row"><div class="stg-info"><h4 style="color:var(--rd)">Alle Daten löschen</h4><p>Unwiderruflich</p></div><button class="btn br bsm" onclick="clearAll()">Löschen</button></div>
