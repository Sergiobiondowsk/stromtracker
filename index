    {id:'d3',name:'TechStart AG',contact:'Tim Weber',email:'tw@techstart.io',phone:'+49 211 34567',unit:'2.OG komplett',area:180,meter:'Z-1003',moveIn:'2023-03-01',monthlyAdvance:220,initReading:5000,notes:'IT-Startup, Server im Büro',status:'active'},
    {id:'d4',name:'Weber Consulting',contact:'Anna Weber',email:'aw@weber-c.de',phone:'+49 211 45678',unit:'3.OG links',area:75,meter:'Z-1004',moveIn:'2022-09-01',monthlyAdvance:100,initReading:15000,notes:'',status:'active'},
    {id:'d5',name:'Klein Design',contact:'Max Klein',email:'mk@kleindesign.de',phone:'+49 211 56789',unit:'3.OG rechts',area:60,meter:'Z-1005',moveIn:'2024-01-01',monthlyAdvance:85,initReading:8000,notes:'Grafikdesign-Agentur',status:'active'}
  ];

  const readings=[],payments=[],mainReadings=[];
  const baseKwh=[320,450,520,280,210];
  const y1=cy()-1,y2=cy();

  [y1,y2].forEach(yr=>{
    const mx=yr===cy()?new Date().getMonth()+1:12;
    for(let m=1;m<=mx;m++){
      let mainTotal=0;
      ts.forEach((t,i)=>{
        const seasonal=1+.15*Math.sin((m-6)*Math.PI/6);
        const kwh=Math.round(baseKwh[i]*seasonal*(.85+Math.random()*.3));
        // Calculate cumulative reading
        const prevReadings=readings.filter(r=>r.tenantId===t.id).sort((a,b)=>a.month.localeCompare(b.month));
        const lastReading=prevReadings.length?prevReadings[prevReadings.length-1].reading:t.initReading;
