  CH.ck=new Chart(document.getElementById('cCK'),{data:{labels:MD,datasets:[{type:'bar',label:'kWh',data:kD,backgroundColor:'rgba(232,185,49,.3)',borderColor:'#e8b931',borderWidth:1,borderRadius:4,yAxisID:'y',order:2},{type:'line',label:'€',data:cD,borderColor:'#2dd4a0',backgroundColor:'rgba(45,212,160,.1)',fill:true,tension:.4,pointRadius:4,pointBackgroundColor:'#2dd4a0',yAxisID:'y1',order:1}]},options:{responsive:true,maintainAspectRatio:false,interaction:{mode:'index',intersect:false},plugins:{legend:{position:'bottom'}},scales:{y:{position:'left',ticks:{callback:v=>v+' kWh'}},y1:{position:'right',ticks:{callback:v=>v+' €'},grid:{display:false}}}}});
  // Heatmap
  const hb=document.getElementById('a-hm');
  if(!D.tenants.length){hb.innerHTML='<div style="text-align:center;color:var(--tx3);padding:20px">Keine Daten</div>';return;}
  let mx=0;D.tenants.forEach(t=>{for(let m=1;m<=12;m++){const c=getConsumption(t.id,yr+'-'+String(m).padStart(2,'0'));if(c&&c>mx)mx=c;}});if(!mx)mx=1;
  let hh='<div class="hm"><div></div>';MD.forEach(m=>hh+=`<div class="hm-h">${m}</div>`);
  D.tenants.forEach(t=>{hh+=`<div class="hm-l">${t.name}</div>`;for(let m=1;m<=12;m++){const k=yr+'-'+String(m).padStart(2,'0');const c=getConsumption(t.id,k)||0;const a=c>0?.15+(c/mx)*.7:.04;hh+=`<div class="hm-c" style="background:${tc(t.id)}${Math.round(a*255).toString(16).padStart(2,'0')}" title="${t.name}: ${fn(c,0)} kWh">${c>0?fn(c,0):''}</div>`;}});
