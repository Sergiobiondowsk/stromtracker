<script>
// ===== DATA =====
const SK='stpro2',CL=['#e8b931','#5b9ef0','#2dd4a0','#ef6060','#9b7ef0','#f0923c','#22d3ee','#f472b6','#a3e635','#c084fc'],MD=['Jan','Feb','Mär','Apr','Mai','Jun','Jul','Aug','Sep','Okt','Nov','Dez'];
const dd=()=>({tenants:[],readings:[],mainReadings:[],payments:[],settings:{price:.35,baseFee:10,buildingName:'Hauptgebäude',address:'',mainMeter:'HZ-0001',distKey:'area',setupDone:false}});
let D=(()=>{try{const r=localStorage.getItem(SK);return r?{...dd(),...JSON.parse(r)}:dd();}catch{return dd();}})();
const sv=()=>localStorage.setItem(SK,JSON.stringify(D));
const id=()=>Date.now().toString(36)+Math.random().toString(36).slice(2,7);
const tc=tid=>{const i=D.tenants.findIndex(t=>t.id===tid);return CL[(i<0?0:i)%CL.length];};
const tn=tid=>(D.tenants.find(t=>t.id===tid)||{}).name||'?';
const fm=m=>{if(!m)return'-';const[y,mo]=m.split('-');return MD[+mo-1]+' '+y;};
const fn=(n,d=1)=>Number(n||0).toLocaleString('de-DE',{minimumFractionDigits:d,maximumFractionDigits:d});
const cm=()=>{const d=new Date();return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0');};
const cy=()=>new Date().getFullYear();
const aY=()=>[...new Set(D.readings.map(r=>r.month.slice(0,4)))].sort();
const fYS=s=>{const y=aY();if(!y.length)y.push(cy().toString());const p=s.value;s.innerHTML=y.map(v=>'<option>'+v+'</option>').join('');s.value=y.includes(p)?p:y[y.length-1];};

// Get consumption for a tenant in a month
function getConsumption(tid, month) {
  const cur = D.readings.find(r=>r.tenantId===tid&&r.month===month);
  if(!cur) return null;
  // Find previous reading
  const prev = getPrevReading(tid, month);
  if(prev===null) return null;
  return Math.max(0, cur.reading - prev);
}

function getPrevReading(tid, month) {
  const allR = D.readings.filter(r=>r.tenantId===tid).sort((a,b)=>a.month.localeCompare(b.month));
  const idx = allR.findIndex(r=>r.month===month);
  if(idx<=0) {
    // Check initial reading from tenant
    const t = D.tenants.find(t=>t.id===tid);
    if(t && t.initReading!==undefined && t.initReading!==null) return t.initReading;
    return null;
  }
  return allR[idx-1].reading;
}

function getMonthlyConsumptions(tid, year) {
  const result = [];
  for(let m=1;m<=12;m++) {
    const key = year+'-'+String(m).padStart(2,'0');
    result.push(getConsumption(tid, key)||0);
  }
  return result;
}

function calcCost(kwh) {
  return kwh * (D.settings.price||.35) + (D.settings.baseFee||0);
}

// Charts
let CH={};const dC=k=>{if(CH[k]){CH[k].destroy();delete CH[k];}};
Chart.defaults.color='#525870';Chart.defaults.borderColor='#262c3a';Chart.defaults.font.family="'Instrument Sans',sans-serif";Chart.defaults.font.size=11;Chart.defaults.plugins.legend.labels.usePointStyle=true;Chart.defaults.plugins.legend.labels.pointStyleWidth=8;Chart.defaults.plugins.legend.labels.boxHeight=6;

// ===== NAV =====
function go(p,el){
  document.querySelectorAll('.page').forEach(x=>x.classList.remove('on'));
  document.getElementById('p-'+p).classList.add('on');
  document.querySelectorAll('.sb-item').forEach(n=>n.classList.remove('on'));
  if(el)el.classList.add('on');
  const T={dashboard:'Dashboard',readings:'Zählerstände',analytics:'Analyse',tenants:'Mieter',billing:'Abrechnung',payments:'Abschläge',history:'Verlauf',settings:'Einstellungen'};
  document.getElementById('topT').textContent=T[p]||'';
  closeSB();rPage(p);
}
function rPage(p){
  updBadges();
  const fn={dashboard:rDash,readings:rReadings,analytics:rAnalytics,tenants:rTenants,billing:rBilling,payments:rPayments,history:rHistory,settings:rSettings};
  if(fn[p])fn[p]();
}
function updBadges(){document.getElementById('b-tc').textContent=D.tenants.length;document.getElementById('b-ec').textContent=D.readings.length;document.getElementById('sb-building').textContent=D.settings.buildingName||'Gebäude';}
function toggleSB(){document.getElementById('sb').classList.toggle('open');document.getElementById('sov').classList.toggle('open');}
function closeSB(){document.getElementById('sb').classList.remove('open');document.getElementById('sov').classList.remove('open');}
function updClk(){const d=new Date();document.getElementById('clk').textContent=d.toLocaleDateString('de-DE',{day:'2-digit',month:'short',year:'numeric'})+' '+d.toLocaleTimeString('de-DE',{hour:'2-digit',minute:'2-digit'});}
setInterval(updClk,15000);updClk();

// ===== WIZARD =====
let wizStep=1;
function startWizard(){wizStep=1;document.getElementById('wizard').style.display='flex';renderWizStep();}
function renderWizStep(){
  document.getElementById('ws1').className='wiz-step'+(wizStep>=1?' done':'')+(wizStep===1?' cur':'');
  document.getElementById('ws2').className='wiz-step'+(wizStep>=2?' done':'')+(wizStep===2?' cur':'');
  document.getElementById('ws3').className='wiz-step'+(wizStep>=3?' done':'')+(wizStep===3?' cur':'');
  const c=document.getElementById('wiz-content');
  if(wizStep===1){
    c.innerHTML=`<h2>⚡ Willkommen bei StromTracker</h2><p class="wiz-sub">Schritt 1: Gebäudedaten eingeben</p>
    <div class="fr"><div class="fg"><label>Gebäudename *</label><input type="text" id="w-name" value="${D.settings.buildingName||''}" placeholder="Gewerbepark Mitte"></div><div class="fg"><label>Adresse</label><input type="text" id="w-addr" value="${D.settings.address||''}" placeholder="Musterstr. 1, 12345 Stadt"></div></div>
    <div class="fr"><div class="fg"><label>Hauptzähler-Nr.</label><input type="text" id="w-main" value="${D.settings.mainMeter||''}" placeholder="HZ-0001"></div><div class="fg"><label>Strompreis (€/kWh)</label><input type="number" id="w-price" value="${D.settings.price||.35}" step="0.001"></div><div class="fg"><label>Grundgebühr (€/Monat)</label><input type="number" id="w-base" value="${D.settings.baseFee||10}" step="0.01"></div></div>
    <div class="wiz-actions"><button class="btn ba" onclick="wizNext()">Weiter →</button></div>`;
  } else if(wizStep===2){
    c.innerHTML=`<h2>🏢 Mieter anlegen</h2><p class="wiz-sub">Schritt 2: Ersten Mieter hinzufügen (weitere können später ergänzt werden)</p>
    <div class="fr"><div class="fg"><label>Firma / Name *</label><input type="text" id="w-tname" placeholder="Müller GmbH"></div><div class="fg"><label>Büro / Einheit *</label><input type="text" id="w-tunit" placeholder="EG links"></div></div>
    <div class="fr"><div class="fg"><label>Zählernummer *</label><input type="text" id="w-tmeter" placeholder="Z-1001"></div><div class="fg"><label>Fläche (m²)</label><input type="number" id="w-tarea" placeholder="80" step="0.1"></div><div class="fg"><label>Monatl. Abschlag (€)</label><input type="number" id="w-tadv" placeholder="120" step="0.01"></div></div>
    <div class="fr"><div class="fg"><label>Anfangs-Zählerstand</label><input type="number" id="w-tinit" placeholder="10000" step="0.01"></div></div>
    ${D.tenants.length?'<p style="color:var(--gn);font-size:12px;margin-bottom:8px">✓ '+D.tenants.length+' Mieter bereits angelegt</p>':''}
    <div class="wiz-actions"><button class="btn bg_" onclick="wizBack()">← Zurück</button><button class="btn bg_" onclick="wizAddTenant()">+ Mieter hinzufügen</button><button class="btn ba" onclick="wizNext()">Weiter →</button></div>`;
  } else if(wizStep===3){
    c.innerHTML=`<h2>✅ Fertig!</h2><p class="wiz-sub">Schritt 3: Setup abgeschlossen</p>
    <div style="background:var(--s2);border-radius:var(--rs);padding:16px;margin-bottom:16px">
      <p style="margin-bottom:8px"><strong>Gebäude:</strong> ${D.settings.buildingName}</p>
      <p style="margin-bottom:8px"><strong>Mieter:</strong> ${D.tenants.length} angelegt</p>
      <p style="margin-bottom:8px"><strong>Strompreis:</strong> ${fn(D.settings.price,3)} €/kWh</p>
      <p><strong>Hauptzähler:</strong> ${D.settings.mainMeter||'-'}</p>
    </div>
    <p style="color:var(--tx2);font-size:13px;margin-bottom:6px">Nächste Schritte:</p>
    <p style="color:var(--tx3);font-size:12px">1. Gehe zu "Zählerstände" um die erste Ablesung einzutragen<br>2. Unter "Mieter" kannst du weitere Mieter hinzufügen<br>3. Unter "Abschläge" monatliche Vorauszahlungen buchen</p>
    <div class="wiz-actions"><button class="btn bg_" onclick="wizBack()">← Zurück</button><button class="btn ba" onclick="wizFinish()">🚀 Los geht's!</button></div>`;
  }
}

function wizNext(){
  if(wizStep===1){
    const n=document.getElementById('w-name').value.trim();
    if(!n)return alert('Gebäudename eingeben!');
    D.settings.buildingName=n;
    D.settings.address=document.getElementById('w-addr').value.trim();
    D.settings.mainMeter=document.getElementById('w-main').value.trim();
    D.settings.price=parseFloat(document.getElementById('w-price').value)||.35;
    D.settings.baseFee=parseFloat(document.getElementById('w-base').value)||0;
    sv();
  }
  wizStep++;renderWizStep();
}
function wizBack(){wizStep--;renderWizStep();}
function wizAddTenant(){
  const name=document.getElementById('w-tname').value.trim(),unit=document.getElementById('w-tunit').value.trim(),meter=document.getElementById('w-tmeter').value.trim();
  if(!name||!unit||!meter)return alert('Name, Büro und Zählernummer sind Pflicht!');
  const area=parseFloat(document.getElementById('w-tarea').value)||0;
  const adv=parseFloat(document.getElementById('w-tadv').value)||0;
  const init=parseFloat(document.getElementById('w-tinit').value);
  D.tenants.push({id:id(),name,contact:'',email:'',phone:'',unit,area,meter,moveIn:'',monthlyAdvance:adv,initReading:isNaN(init)?null:init,notes:'',status:'active'});
  sv();
  ['w-tname','w-tunit','w-tmeter','w-tarea','w-tadv','w-tinit'].forEach(x=>document.getElementById(x).value='');
  renderWizStep();
}
function wizFinish(){D.settings.setupDone=true;sv();document.getElementById('wizard').style.display='none';rDash();updBadges();}

// ===== DASHBOARD =====
function rDash(){
  const m=cm(),y=cy().toString();
  document.getElementById('d-sub').textContent=(D.settings.buildingName||'Gebäude')+' – '+fm(m);

  // Calc current month totals
  let mKwh=0,mCost=0;
  D.tenants.forEach(t=>{const c=getConsumption(t.id,m);if(c!==null){mKwh+=c;mCost+=calcCost(c);}});

  // Prev month
  const pd=new Date();pd.setMonth(pd.getMonth()-1);
  const pm=pd.getFullYear()+'-'+String(pd.getMonth()+1).padStart(2,'0');
  let pmKwh=0;
  D.tenants.forEach(t=>{const c=getConsumption(t.id,pm);if(c!==null)pmKwh+=c;});
  const kD=pmKwh?((mKwh-pmKwh)/pmKwh*100):0;

  // Year totals
  let yKwh=0,yCost=0;
  for(let mo=1;mo<=12;mo++){const k=y+'-'+String(mo).padStart(2,'0');D.tenants.forEach(t=>{const c=getConsumption(t.id,k);if(c!==null){yKwh+=c;yCost+=calcCost(c);}});}
  const yMonths=new Set();D.readings.filter(r=>r.month.startsWith(y)).forEach(r=>yMonths.add(r.month));
  const avgM=yMonths.size?yKwh/yMonths.size:0;

  // Payments this year
  const yPay=D.payments.filter(p=>p.month&&p.month.startsWith(y)).reduce((s,p)=>s+(p.amount||0),0);

  const bg=v=>v===0?'':(v>0?`<span class="bu">↑${fn(Math.abs(v))}%</span>`:`<span class="bd_">↓${fn(Math.abs(v))}%</span>`);
  document.getElementById('d-stats').innerHTML=`
    <div class="sc cy"><div class="si">⚡</div><div class="sl">Verbrauch Monat</div><div class="sv">${fn(mKwh,0)} <span class="su">kWh</span></div><div class="sf">${bg(kD)} <span style="color:var(--tx3)">vs. Vormonat</span></div></div>
    <div class="sc cg"><div class="si">💰</div><div class="sl">Kosten Monat</div><div class="sv">${fn(mCost,2)} <span class="su">€</span></div></div>
    <div class="sc cb_"><div class="si">📅</div><div class="sl">Gesamt ${y}</div><div class="sv">${fn(yKwh,0)} <span class="su">kWh</span></div><div class="sf"><span class="bn">${fn(yCost,2)} €</span></div></div>
    <div class="sc cp"><div class="si">💶</div><div class="sl">Abschläge ${y}</div><div class="sv">${fn(yPay,2)} <span class="su">€</span></div><div class="sf"><span style="color:var(--tx3)">Saldo: ${fn(yPay-yCost,2)} €</span></div></div>
    <div class="sc cr"><div class="si">📐</div><div class="sl">Ø / Monat</div><div class="sv">${fn(avgM,0)} <span class="su">kWh</span></div><div class="sf"><span style="color:var(--tx3)">${D.tenants.length} Mieter</span></div></div>`;

  // Alerts
  let alerts=[];
  D.tenants.forEach(t=>{
    const r=D.readings.find(r=>r.tenantId===t.id&&r.month===cm());
    if(!r) alerts.push({type:'miss',text:`${t.name}: Ablesung für ${fm(cm())} fehlt`});
    const c=getConsumption(t.id,cm());
    const cp=getConsumption(t.id,pm);
    if(c!==null&&cp!==null&&cp>0&&c>cp*1.5) alerts.push({type:'warn',text:`${t.name}: Verbrauch ${fn(c,0)} kWh – ${fn(((c-cp)/cp*100),0)}% über Vormonat!`});
  });
  const aEl=document.getElementById('d-alerts');
  aEl.innerHTML=alerts.length?alerts.map(a=>`<div style="margin-bottom:6px"><span class="alert-badge ${a.type==='miss'?'alert-miss':'alert-warn'}">${a.type==='miss'?'⚠ Fehlend':'⚠ Warnung'}</span> <span style="font-size:13px;color:var(--tx2)">${a.text}</span></div>`).join(''):'';

  renderDashCharts();renderRanking();renderPrognose();
}

function renderDashCharts(){
  const s=document.getElementById('d-yr');fYS(s);const yr=s.value;
  dC('bar');
  const ds=D.tenants.map(t=>({label:t.name,data:getMonthlyConsumptions(t.id,yr),backgroundColor:tc(t.id)+'cc',borderColor:tc(t.id),borderWidth:1,borderRadius:4,borderSkipped:false}));
  CH.bar=new Chart(document.getElementById('cBar'),{type:'bar',data:{labels:MD,datasets:ds},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom'}},scales:{x:{stacked:true,grid:{display:false}},y:{stacked:true,ticks:{callback:v=>v+' kWh'}}},interaction:{mode:'index'}}});
  dC('don');
  const dD=D.tenants.map(t=>{let tot=0;for(let m=1;m<=12;m++){const c=getConsumption(t.id,yr+'-'+String(m).padStart(2,'0'));if(c)tot+=c;}return tot;});
  CH.don=new Chart(document.getElementById('cDon'),{type:'doughnut',data:{labels:D.tenants.map(t=>t.name),datasets:[{data:dD,backgroundColor:D.tenants.map(t=>tc(t.id)),borderWidth:0,hoverOffset:8}]},options:{responsive:true,maintainAspectRatio:false,cutout:'65%',plugins:{legend:{position:'bottom'}}}});
}

function renderRanking(){
  const el=document.getElementById('d-rank'),yr=cy().toString();
  const rk=D.tenants.map(t=>{let kwh=0;for(let m=1;m<=12;m++){const c=getConsumption(t.id,yr+'-'+String(m).padStart(2,'0'));if(c)kwh+=c;}return{...t,kwh};}).sort((a,b)=>b.kwh-a.kwh);
  if(!rk.length){el.innerHTML='<div class="empty" style="padding:20px;text-align:center;color:var(--tx3)">Keine Mieter</div>';return;}
  el.innerHTML=rk.map((r,i)=>`<div class="ri"><div class="rn ${i===0?'t1':''}">${i+1}</div><div class="td" style="background:${tc(r.id)}"></div><div class="rinfo"><div class="nm">${r.name}</div><div class="dt">${r.unit} · ${r.meter}</div></div><div class="rv">${fn(r.kwh,0)} <span class="ut">kWh</span></div></div>`).join('');
}

function renderPrognose(){
  const el=document.getElementById('d-prog'),yr=cy().toString();
  let h='';
  D.tenants.forEach(t=>{
    let tot=0,ms=0;
    for(let m=1;m<=12;m++){const c=getConsumption(t.id,yr+'-'+String(m).padStart(2,'0'));if(c){tot+=c;ms++;}}
    if(!ms)return;
    const proj=(tot/ms)*12,pct=Math.min((tot/proj)*100,100),pC=proj*(D.settings.price||.35)+(D.settings.baseFee||0)*12;
    h+=`<div class="pr"><div class="prh"><div class="prl"><span class="td" style="background:${tc(t.id)}"></span>${t.name}</div><div class="prs">${fn(tot,0)}/${fn(proj,0)} kWh · ~${fn(pC,2)}€</div></div><div class="prt"><div class="prf" style="width:${pct}%;background:${tc(t.id)}"></div></div></div>`;
  });
  el.innerHTML=h||'<div style="text-align:center;color:var(--tx3);padding:20px">Keine Daten</div>';
}

